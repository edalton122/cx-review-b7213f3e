---
import Logo from './Logo.astro';
import site from '../data/site.json';
import musthaves from '../data/musthaves.json';

// Counts come from the data. The placeholder card is not counted.
const real = musthaves.filter((m) => !('placeholder' in m && m.placeholder));
const counts = Object.fromEntries(site.statuses.map((s) => [s.key, real.filter((m) => m.status === s.key).length]));
---
<div class="hero">
  <p class="eyebrow prep">Prepared for <Logo name="cannon" /> · Working draft</p>
  <h1>What you keep, what changes and what it costs</h1>
  <p class="lede">You told us your biggest worry is losing proposal features when you move off Roofr. This page goes through each must-have and shows how you do it today, how it works in Salesforce, and whether it's ready or still being confirmed.</p>
  <div class="meta">
    <span>Updated <b>{site.updated}</b></span>
    <span>Review together <b>{site.meetingDate} · {site.meetingTime}</b></span>
    <span>Items marked <b>Confirming</b> will be answered by Strong CRM before or during that call</span>
  </div>
  <div class="summary" id="summary" role="group" aria-label="Filter must-haves by status">
    {site.statuses.map((s) => (
      <button type="button" data-filter={s.key} aria-pressed="false">
        <span class={`n s-${s.key}`}>{counts[s.key]}</span>
        <span class="l">{s.label}</span>
        <span class="d">{s.meaning}</span>
      </button>
    ))}
  </div>
</div>
