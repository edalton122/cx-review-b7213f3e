---
import { shotUrl } from '../lib/assets';
import site from '../data/site.json';

interface Shot { src: string; side: 'roofr' | 'sf'; caption: string; label?: string }
interface Item {
  id: string;
  title: string;
  why: string;
  status: string;
  placeholder?: boolean;
  pillLabel?: string;
  today?: string[];
  salesforce?: string[];
  cost?: string;
  note?: { kind: string; text: string; link?: string };
  shots?: Shot[];
}
const { item } = Astro.props as { item: Item };
const label = item.pillLabel ?? site.statuses.find((s) => s.key === item.status)?.label ?? item.status;
const shots = (item.shots ?? []).map((s) => ({ ...s, url: shotUrl(s.src) })).filter((s) => s.url);
---
<article class={`card${item.placeholder ? ' placeholder' : ''}`} id={`mh-${item.id}`} data-status={item.placeholder ? 'all-only' : item.status}>
  <div class="card-top">
    <div class="ttl"><h3>{item.title}</h3><p class="why">{item.why}</p></div>
    <span class={`pill s-${item.status}`}>{label}</span>
  </div>
  {!item.placeholder && (
    <>
      <div class="cmp">
        <div>
          <p class="side">Today in Roofr</p>
          <ul>{item.today?.map((t) => <li>{t}</li>)}</ul>
          {shots.filter((s) => s.side === 'roofr').length > 0 && (
            <div class="shots">
              {shots.filter((s) => s.side === 'roofr').map((s) => (
                <button type="button" class="shot" data-full={s.url} data-caption={s.caption}>
                  <img src={s.url!} alt={s.caption} loading="lazy" />
                  <span>{s.label ?? 'Screenshot'}</span>
                </button>
              ))}
            </div>
          )}
        </div>
        <div class="sf">
          <p class="side">In Salesforce</p>
          <ul>{item.salesforce?.map((t) => <li>{t}</li>)}</ul>
          {shots.filter((s) => s.side === 'sf').length > 0 && (
            <div class="shots">
              {shots.filter((s) => s.side === 'sf').map((s) => (
                <button type="button" class="shot" data-full={s.url} data-caption={s.caption}>
                  <img src={s.url!} alt={s.caption} loading="lazy" />
                  <span>{s.label ?? 'Screenshot'}</span>
                </button>
              ))}
            </div>
          )}
        </div>
      </div>
      <div class="card-foot">
        <span><b>Cost:</b> {item.cost}</span>
        {item.note && (
          <span class="q">
            {item.note.kind && <b>{item.note.kind}:</b>}{' '}
            {item.note.text}
            {item.note.link && <> <a href={item.note.link}>Open the worksheet</a>.</>}
          </span>
        )}
      </div>
    </>
  )}
</article>
