---
import flow from '../data/flow.json';
import { shotUrl } from '../lib/assets';

const tagLabel: Record<string, string> = { hand: 'by hand', auto: 'auto', review: 'review', order: 'order' };
const lanes = [
  { key: 'roofr', title: 'Today in Roofr', prefix: 'roofr', steps: flow.roofr },
  { key: 'sf', title: 'In Salesforce', prefix: 'sf', steps: flow.sf },
] as const;
const byHand = (steps: { tag: string }[]) => steps.filter((s) => s.tag === 'hand').length;
---
<section id="flow">
  <div class="sec-head">
    <p class="eyebrow">Proposal to production</p>
    <h2>The same job, two ways</h2>
    <p class="muted">The left side follows Roofr's own help center. Once your screenshots arrive, we'll swap in your actual steps.</p>
  </div>
  <div class="flow">
    {lanes.map((lane) => (
      <div class="lane">
        <div class="lane-head">
          <h3>{lane.title}</h3>
          <span class="mono muted">{byHand(lane.steps)} steps by hand</span>
        </div>
        <ol class="steps" data-lane={lane.key}>
          {lane.steps.map((s, i) => {
            const file = `${lane.prefix}-${String(i + 1).padStart(2, '0')}.png`;
            const url = shotUrl(file);
            return (
              <li>
                <div>
                  <p class="t">{s.title}</p>
                  <p class="x">{s.detail}</p>
                  {url && (
                    <div class="shots">
                      <button type="button" class="shot" data-full={url} data-caption={`${lane.title}, step ${i + 1}: ${s.title}`}>
                        <img src={url} alt={`Screenshot: ${s.title}`} loading="lazy" />
                        <span>{lane.key === 'roofr' ? 'Generic Roofr example (replace with Cannon\'s own)' : 'Salesforce'}</span>
                      </button>
                    </div>
                  )}
                </div>
                <span class={`tag ${s.tag}`}>{tagLabel[s.tag]}</span>
              </li>
            );
          })}
        </ol>
      </div>
    ))}
  </div>
  <p class="note" style="margin-top:16px">Steps marked "auto" on the Salesforce side depend on Strong CRM's QuickMeasure and QuickBooks builds. Those are listed below with their status.</p>
</section>
