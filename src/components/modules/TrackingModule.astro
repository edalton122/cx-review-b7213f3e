---
const icons = {
  send: '<path d="M22 2 11 13M22 2l-7 20-4-9-9-4 20-7z"/>',
  eye: '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8S1 12 1 12z"/><circle cx="12" cy="12" r="3"/>',
  bell: '<path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9M13.73 21a2 2 0 0 1-3.46 0"/>',
  pen: '<path d="M12 20h9M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4z"/>',
};
const steps = [
  { icon: icons.send, title: 'Sent', time: 'Thu 11:05 AM', text: 'The rep sends the proposal from the quote. Status and time are saved.' },
  { icon: icons.eye, title: 'Viewed', time: 'Thu 4:05 PM', text: 'The homeowner opens it. The e-signature tool writes "Viewed" back to the quote.' },
  { icon: icons.bell, title: 'Rep alerted', time: 'Thu 4:05 PM', text: 'A Flow notifies the rep right away, so the follow-up call happens while it\'s fresh.', alert: true },
  { icon: icons.pen, title: 'Signed', time: 'When they sign', text: 'The signed proposal is saved on the job, and production can start.' },
];
type Cell = [v: 'yes' | 'no' | 'maybe', t: string];
const rows: { what: string; roofr: Cell; sf: Cell }[] = [
  { what: 'Proposal viewed', roofr: ['yes', 'Yes, since June 2026'], sf: ['yes', 'Yes, from the e-signature tool'] },
  { what: 'Proposal signed', roofr: ['yes', 'Yes'], sf: ['yes', 'Yes'] },
  { what: 'Time of each status', roofr: ['yes', 'Status history on the job card'], sf: ['yes', 'Saved on the quote'] },
  { what: 'Instant alert to the rep', roofr: ['maybe', 'Not documented'], sf: ['yes', 'Flow notification'] },
  { what: 'Email opened', roofr: ['maybe', 'Not documented'], sf: ['yes', 'Email open tracking'] },
  { what: 'Links clicked or time on page', roofr: ['no', 'Not documented'], sf: ['no', 'Not documented'] },
];
---
<div class="sec-head">
  <p class="eyebrow">How it plays out</p>
  <h2>From "sent" to "signed", and who knows when</h2>
  <p class="sub">The times match the demo quote in the screenshot above. They're simulated until the e-signature tool is connected.</p>
</div>
<div class="timeline">
  {steps.map((s) => (
    <div class:list={['tl', { alert: s.alert }]}>
      <div class="dot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={s.icon} /></div>
      <h4>{s.title}</h4>
      <p class="time">{s.time}</p>
      <p>{s.text}</p>
    </div>
  ))}
</div>
<div class="matrix-scroll">
  <table class="matrix">
    <thead><tr><th>What you can see</th><th>Roofr today</th><th class="sfc">Cannon on Salesforce</th></tr></thead>
    <tbody>
      {rows.map((r) => (
        <tr>
          <th scope="row">{r.what}</th>
          <td><span class={r.roofr[0]}>{r.roofr[1]}</span></td>
          <td><span class={r.sf[0]}>{r.sf[1]}</span></td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
