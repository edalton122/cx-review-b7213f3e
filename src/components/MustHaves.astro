---
import musthaves from '../data/musthaves.json';
import site from '../data/site.json';
import MustHaveCard from './MustHaveCard.astro';
---
<section id="musthaves">
  <div class="sec-head">
    <p class="eyebrow">Must-haves</p>
    <h2>Each item, side by side</h2>
    <p class="muted">Each card has a status. We'll add the items from your list as they come in.</p>
  </div>
  <div class="filters" id="filters" role="group" aria-label="Filter by status">
    <button type="button" data-filter="all" aria-pressed="true">All</button>
    {site.statuses.map((s) => <button type="button" data-filter={s.key} aria-pressed="false">{s.label}</button>)}
  </div>
  <div class="cards" id="cards">
    {musthaves.map((item) => <MustHaveCard item={item as any} />)}
  </div>
</section>
