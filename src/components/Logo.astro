---
import { logoUrl } from '../lib/assets';

interface Props {
  name: 'salesforce' | 'strongcrm' | 'cannon';
}
const { name } = Astro.props;
const labels = { salesforce: 'Salesforce', strongcrm: 'Strong CRM', cannon: 'Cannon Exteriors' } as const;
const url = logoUrl(`${name}.svg`);
---
{url ? <img src={url} alt={labels[name]} /> : <span class="logo-text">{labels[name]}</span>}
