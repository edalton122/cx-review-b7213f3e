---
const need = [
  'Screenshots of the Roofr steps you rely on most',
  'One QuickMeasure report (the XML file) and the Roofr proposal you built from it',
  'Your waste factors by material, and when you raise them',
  'How many photos a typical proposal carries',
  'Whether you order materials through Roofr',
  'Anything your team would add to this list',
];
const back = [
  'Every "Confirming" item answered with a status and a cost',
  'A card for each item on your must-have list',
  'Your job rebuilt in Salesforce, with the quote next to your Roofr proposal',
  'An updated total cost',
];
---
<section id="next">
  <div class="sec-head">
    <p class="eyebrow">Next steps</p>
    <h2>One real job, start to finish</h2>
    <p class="muted">The best proof is running one of your past jobs through Salesforce and comparing it with the Roofr proposal you sent.</p>
  </div>
  <div class="duo">
    <div class="panel"><h3>What we need from you</h3><ol>{need.map((s) => <li>{s}</li>)}</ol></div>
    <div class="panel"><h3>What you'll get back</h3><ul>{back.map((s) => <li>{s}</li>)}</ul></div>
  </div>
</section>
